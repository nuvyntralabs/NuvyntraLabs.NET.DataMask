<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>NuvyntraLabs.NET.DataMask</RootNamespace>
    <AssemblyName>NuvyntraLabs.NET.DataMask</AssemblyName>
    <PackageId>NuvyntraLabs.NET.DataMask</PackageId>
    <Title>NuvyntraLabs.NET.DataMask</Title>
    <Description>Mask a phone, email, card, Aadhaar, PAN, GSTIN, JWT, API key, connection string, or JSON property before it is logged.</Description>
    <PackageTags>nuvyntra;datamask;redaction;logging</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://nuvyntralabs.github.io/packages/nuvyntralabs-net-datamask/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/NuvyntraLabs.NET.DataMask</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
